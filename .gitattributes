# Keep text sources portable across Windows/Linux clones.
* text=auto
.gitattributes text eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# KataGo model and ELF binary must never be treated as text.
app/src/main/assets/katago/model.txt -text
app/src/main/jniLibs/arm64-v8a/libkatago.so -text
